    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Nodo Python en Dynamo (motor CPython3 o IronPython2)\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ncarpeta      = IN[0]   # ruta destino, ej: r\"C:\\Exportar\"\r\ndelimitador  = IN[1]   # \";\"  \",\"  o  \"\\t\"\r\n\r\nopts = ViewScheduleExportOptions()\r\nopts.FieldDelimiter       = delimitador\r\nopts.TextQualifier        = ExportTextQualifier.DoubleQuote\r\nopts.ColumnHeaders        = ExportColumnHeaders.OneRow\r\nopts.Title                = False   # el nombre de archivo ya identifica la tabla\r\nopts.HeadersFootersBlanks = False   # datos limpios, sin filas de grupo/blancos\r\n\r\ntablas = FilteredElementCollector(doc).OfClass(ViewSchedule).ToElements()\r\n\r\nexportadas = []\r\nfor t in tablas:\r\n    if t.IsTitleblockRevisionSchedule:   # ignora tablas de revisiones de rótulos\r\n        continue\r\n    nombre = t.Name\r\n    for c in r'\\/:*?\"<>|':\r\n        nombre = nombre.replace(c, \"_\")   # limpia caracteres inválidos\r\n    t.Export(carpeta, nombre + \".csv\", opts)\r\n    exportadas.append(nombre)\r\n\r\nOUT = exportadas",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "725c8e517be54d0683d329d9e8c4da5c",
      "NodeType": "PythonScriptNode",
      "Inputs": [
